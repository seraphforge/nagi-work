---
import '../styles/global.css';
import { site, projects } from '../data/site';
---
<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11130f" />
    <meta name="description" content="Nagi｜網站開發、活動頁與小型工具。學生開發者的作品與合作方式。" />
    <title>Nagi — 把想法做成真的</title>
  </head>
  <body>
    <a class="skip" href="#main">跳到主要內容</a>
    <header class="site-header wrap">
      <a class="brand" href="#top" aria-label="Nagi，回到首頁"><span class="brand-mark">N</span><span>NAGI<span class="brand-dot">.</span></span></a>
      <nav aria-label="主要導覽">
        <a href="#work">作品 <span>03</span></a>
        <a href="#about">關於</a>
        <a class="nav-contact" href="#contact">找我合作 <span>↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero wrap" id="top">
        <div class="hero-copy">
          <p class="eyebrow"><span class="live-dot"></span> STUDENT DEVELOPER <span class="eyebrow-sep">/</span> TAIWAN</p>
          <h1>把想法<br />做成<span class="accent-word">真的。</span></h1>
          <p class="hero-description">我是 Nagi，喜歡把網站、硬體和各種奇怪的點子，變成真的能用的東西。</p>
          <div class="hero-actions">
            <a class="button-primary" href={`mailto:${site.email}?subject=${encodeURIComponent('網站合作詢問')}`}>跟我聊你的點子 <span>↗</span></a>
            <a class="text-link" href="#work">先看我做過什麼 <span>↓</span></a>
          </div>
        </div>

        <div class="hero-visual" aria-label="無人機線稿與工程筆記">
          <div class="visual-top"><span>FIELD NOTES / 01</span><span>25°01′N 121°27′E</span></div>
          <div class="blueprint">
            <svg viewBox="0 0 520 400" role="img" aria-labelledby="drone-title drone-desc">
              <title id="drone-title">無人機俯視工程線稿</title>
              <desc id="drone-desc">以線條繪製的四軸無人機結構，中央有螢光綠色機身標記。</desc>
              <g class="blueprint-grid">
                <path d="M0 50H520M0 100H520M0 150H520M0 200H520M0 250H520M0 300H520M0 350H520M65 0V400M130 0V400M195 0V400M260 0V400M325 0V400M390 0V400M455 0V400" />
              </g>
              <g class="drone-line" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M104 86 218 181M416 86 302 181M104 314l114-95m198 95-114-95" />
                <path d="m219 174 41-19 41 19v52l-41 20-41-20z" />
                <path d="M93 63c-19 0-34 15-34 34s15 34 34 34 34-15 34-34-15-34-34-34Zm334 0c-19 0-34 15-34 34s15 34 34 34 34-15 34-34-15-34-34-34ZM93 280c-19 0-34 15-34 34s15 34 34 34 34-15 34-34-15-34-34-34Zm334 0c-19 0-34 15-34 34s15 34 34 34 34-15 34-34-15-34-34-34Z" />
                <circle cx="260" cy="200" r="10" />
                <path d="M260 116v35m0 98v35m-84-84h35m98 0h35" stroke-dasharray="3 7" />
              </g>
              <g class="blueprint-labels">
                <text x="28" y="48">FRAME / QUAD-04</text>
                <text x="360" y="370">BUILD IN PROGRESS</text>
                <text x="274" y="194">N</text>
              </g>
              <circle class="blueprint-accent" cx="260" cy="200" r="4" />
            </svg>
            <span class="crosshair crosshair-a">+</span><span class="crosshair crosshair-b">+</span>
          </div>
          <div class="visual-bottom"><span>LEARN BY BUILDING.</span><span class="visual-coordinate">新北・持續製作中</span></div>
          <span class="visual-index">01—03</span>
        </div>
        <div class="hero-foot"><span>網站・工具・專題實作</span><span>SCROLL TO EXPLORE <b>↓</b></span></div>
      </section>

      <section class="intro-band" id="about">
        <div class="wrap intro-layout">
          <p class="section-index">01 <span>/ ABOUT</span></p>
          <div class="intro-copy">
            <h2>我喜歡從一個<br class="mobile-break" />「如果可以呢？」開始。</h2>
            <div class="intro-columns">
              <p>我是亞東科大的學生，平常做網站，也和團隊做無人機、ESP32 和醫療資安相關專題。比起只聊點子，我更喜歡把東西做出來、實際試一遍。</p>
              <p>現在也接一些網站和小工具的合作。你把需求告訴我，我會先說明能怎麼做、時間和費用；確認方向再開始，過程保持好溝通。</p>
            </div>
            <a class="inline-link" href={`mailto:${site.email}`}>合作方式，直接寄信聊 <span>↗</span></a>
          </div>
        </div>
      </section>

      <section class="services wrap">
        <p class="section-index">02 <span>/ WHAT I DO</span></p>
        <div class="service-content">
          <h2>可以一起完成的事</h2>
          <div class="service-list">
            <div class="service-row"><span class="service-no">01</span><h3>個人／社團網站</h3><p>把你的內容整理好，做成一個清楚、好看的網站。</p><span class="service-symbol">↗</span></div>
            <div class="service-row"><span class="service-no">02</span><h3>活動頁與手機版</h3><p>讓活動資訊在手機上也容易看、容易找到重點。</p><span class="service-symbol">↗</span></div>
            <div class="service-row"><span class="service-no">03</span><h3>小型工具／網站修改</h3><p>先了解你卡在哪，再一起找一個務實的做法。</p><span class="service-symbol">↗</span></div>
          </div>
          <p class="service-note">學生接案中｜小型需求最適合。遇到不熟的技術，我會先說明，不會硬接。</p>
        </div>
      </section>

      <section class="work-section" id="work">
        <div class="wrap work-wrap">
          <div class="work-heading"><p class="section-index">03 <span>/ SELECTED WORK</span></p><p class="work-count">個人作品與團隊協作 <span>— 2024–26</span></p></div>
          <div class="work-title-line"><h2>做過的東西<span class="accent-word">.</span></h2><span>點進去看細節 <b>↘</b></span></div>
          <div class="project-list">
            {projects.map((p, index) => (
              <a class="project-row" href={p.url} target="_blank" rel="noopener noreferrer">
                <span class="project-number">0{index + 1}</span>
                <div class="project-main"><div class="project-meta"><span>{p.category}</span><span>{p.tags.join('　·　')}</span></div><h3>{p.title}</h3><p>{p.description}</p></div>
                <span class="project-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          <a class="github-link" href={site.githubUrl} target="_blank" rel="noopener noreferrer"><span>看 GitHub 上其他實驗</span><span>↗</span></a>
        </div>
      </section>

      <section class="contact-section wrap" id="contact">
        <p class="section-index">04 <span>/ YOUR TURN</span></p>
        <div class="contact-main">
          <p class="contact-kicker"><span class="live-dot"></span> GOT SOMETHING IN MIND?</p>
          <h2>那我們<br />來做點<span class="accent-word">好玩的。</span></h2>
          <p class="contact-copy">寄信告訴我你想做什麼、預算和時間。我會親自回覆，一起確認怎麼開始。</p>
          <a class="button-primary button-large" href={`mailto:${site.email}?subject=${encodeURIComponent('網站合作詢問')}`}>寄信給 Nagi <span>↗</span></a>
          <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="contact-stamp" aria-hidden="true"><span>OPEN</span><span>FOR</span><span>IDEAS<span class="stamp-star">✳</span></span></div>
      </section>
    </main>

    <footer class="site-footer wrap"><a class="footer-brand" href="#top">NAGI<span>.</span></a><span>慢慢做，認真做。© 2026</span><a href="#top">回到頂端 ↑</a></footer>
  </body>
</html>
